{
  "name": "zane-personal",
  "main": "../../workers/personal.mjs",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/PhotoNotes",
      "/PhotoNotes/*",
      "/photonotes",
      "/photonotes/*",
      "/photo-notes",
      "/photo-notes/*",
      "/thanks",
      "/thanks/*"
    ]
  },
  "services": [
    {
      "binding": "PHOTO_NOTES",
      "service": "zane-photo-notes"
    }
  ]
}
