{
  "name": "zane-personal",
  "main": "../../workers/personal.mjs",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/home.css",
      "!/home.js",
      "!/styles.css"
    ]
  },
  "services": [
    {
      "binding": "PHOTO_NOTES",
      "service": "zane-photo-notes"
    }
  ]
}
